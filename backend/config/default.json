{
  "host": "localhost",
  "port": "PORT",
  "public": "../public/",
  "defaultEmail": "DEFAULT_EMAIL",
  "paginate": {
    "default": 10,
    "max": 50
  },
  "authentication": {
    "entity": "user",
    "service": "api/users",
    "secret": "JWT_SECRET",
    "authStrategies": ["jwt", "local"],
    "jwtOptions": {
      "header": {
        "typ": "access"
      },
      "audience": "JWT_AUDIENCE",
      "issuer": "JWT_ISSUER",
      "algorithm": "HS256",
      "expiresIn": "JWT_EXPIRES_IN"
    },
    "local": {
      "usernameField": "email",
      "passwordField": "password"
    }
  },
  "postgres": {
    "client": "DB_CLIENT",
    "connection": {
      "host": "DB_HOST",
      "user": "DB_USER",
      "password": "DB_PASSWORD",
      "database": "DB_DATABASE"
    }
  },
  "mattermost": {
    "baseUrl": "MATTERMOST_BASE_URL",
    "adminToken": "MATTERMOST_ADMIN_TOKEN"
  },
  "mailer": {
    "transporter": {
      "host": "MAILER_HOST",
      "port": "MAILER_PORT",
      "secureConnection": "MAILER_SECURE",
      "auth": {
        "user": "MAILER_USER",
        "pass": "MAILER_PASS"
      },
      "tls": {
        "ciphers": "SSLv3"
      }
    }
  },
  "cors": {
    "origins": "CORS_ORIGINS"
  }
}