# Serveur
PORT=3030
HOST=localhost

# Cors
CORS_ORIGINS=http://localhost:3000

# Authentication
JWT_SECRET=YOUR_VERY_LONG_SECRET_KEY
JWT_AUDIENCE=https://yourdomain.com
JWT_ISSUER=feathers
JWT_EXPIRES_IN=1d

# Base de données
DB_CLIENT=pg
DB_HOST=localhost
DB_USER=username
DB_PASSWORD=password
DB_DATABASE=db_name

# Mattermost
MATTERMOST_BASE_URL=http://localhost:8065
MATTERMOST_ADMIN_TOKEN=your_mattermost_admin_token

# Mailer
MAILER_HOST=smtp.example.com
MAILER_PORT=2525
MAILER_SECURE=false
MAILER_USER=username
MAILER_PASS=password
DEFAULT_EMAIL=support@example.com
