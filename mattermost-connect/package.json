{
  "name": "mattermost-connect",
  "version": "0.1.0",
  "description": "A modern React component library for Mattermost integration",
  "author": "Your Name",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "type": "module",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.js",
    "dev": "rollup -c rollup.config.js -w",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "postinstall": "node -e \"try { require('./postinstall.js') } catch (e) { console.log('Skipping build step in install phase') }\"",
    "test": "jest",
    "demo": "node setup.js demo",
    "setup": "node setup.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.0.1",
    "@mui/material": "^7.0.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.2.1",
    "@rollup/plugin-terser": "^0.4.3",
    "@rollup/plugin-typescript": "^11.1.3",
    "@storybook/addon-essentials": "^7.6.17",
    "@storybook/addon-interactions": "^7.6.17",
    "@storybook/addon-links": "^7.6.17",
    "@storybook/addon-styling": "^1.3.7",
    "@storybook/blocks": "^7.6.17",
    "@storybook/react": "^7.6.17",
    "@storybook/react-vite": "^7.6.17",
    "@storybook/testing-library": "^0.2.2",
    "@tanstack/react-query": "5.74.4",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.5.9",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.6.4",
    "jest-environment-jsdom": "^29.6.4",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "10.1.0",
    "rimraf": "^5.0.1",
    "rollup": "^3.29.1",
    "rollup-plugin-dts": "^6.0.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "storybook": "^7.6.17",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2",
    "zustand": "5.0.3"
  },
  "keywords": [
    "mattermost",
    "react",
    "component",
    "chat",
    "messaging",
    "communication",
    "integration",
    "material-ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/mattermost-connect.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/mattermost-connect/issues"
  },
  "homepage": "https://github.com/yourusername/mattermost-connect#readme",
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
